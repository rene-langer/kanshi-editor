#!/usr/bin/env python3
"""Launcher for kanshi-editor.

Finds the kanshi_editor package next to this script, so the same launcher works
from a git checkout (bin/../kanshi_editor) and from any install prefix, such as
/usr, /app (Flatpak) or an AppImage (<prefix>/bin/../share/kanshi-editor).
"""

import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
for candidate in (os.path.join(here, os.pardir), os.path.join(here, os.pardir, "share", "kanshi-editor")):
    if os.path.isfile(os.path.join(candidate, "kanshi_editor", "__init__.py")):
        sys.path.insert(0, os.path.abspath(candidate))
        break

from kanshi_editor.app import main  # noqa: E402

sys.exit(main())
